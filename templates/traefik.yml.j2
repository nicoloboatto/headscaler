#######################################################################
# Minimal static config – focuses on secure defaults
#######################################################################
entryPoints:
  web:          { address: ":80" }
  websecure:    { address: ":443" }

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false


certificatesResolvers:
  le:
    acme:
      email: "{{ acme_email }}"
      storage: /acme/acme.json
      httpChallenge:
        entryPoint: web